<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/line"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:layout_weight="1"
    android:background="@drawable/w_tile_classic"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="3dp"
    android:paddingEnd="9dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/l_img"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="0dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/l_t1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#f1f2df"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/l_t2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#a2bbb1"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/l_pill"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:minWidth="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/l_pill_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/w_pill" />

        <TextView
            android:id="@+id/l_pill_txt"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:singleLine="true"
            android:textColor="#0b1500"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
