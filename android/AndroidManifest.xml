<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.boardroamer.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:label="Board Roamer"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:debuggable="@DEBUGGABLE@">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" a link to the app from a browser -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Links to posts, searches and pools on the supported sites open in Board Roamer. An alias, so Settings can turn it off. -->
        <activity-alias
            android:name=".LinkAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="e621.net" />
                <data android:host="www.e621.net" />
                <data android:host="e926.net" />
                <data android:host="danbooru.donmai.us" />
                <data android:host="gelbooru.com" />
                <data android:host="www.gelbooru.com" />
                <data android:host="safebooru.org" />
                <data android:host="derpibooru.org" />
                <data android:host="www.derpibooru.org" />
                <data android:pathPrefix="/posts" />
                <data android:pathPrefix="/post/show" />
                <data android:pathPrefix="/pools" />
                <data android:pathPrefix="/index.php" />
                <data android:pathPrefix="/images" />
                <data android:pathPrefix="/search" />
                <data android:pathPattern="/[0-9][0-9]*" />
            </intent-filter>
        </activity-alias>

        <!-- Home screen widgets: Following, Library and Local, each in a few layouts. -->
        <receiver
            android:name=".WidgetProviders$FollowStrip"
            android:exported="false"
            android:label="@string/w_follow_strip">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_follow_strip" />
        </receiver>
        <receiver
            android:name=".WidgetProviders$FollowList"
            android:exported="false"
            android:label="@string/w_follow_list">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_follow_list" />
        </receiver>
        <receiver
            android:name=".WidgetProviders$FollowSummary"
            android:exported="false"
            android:label="@string/w_follow_summary">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_follow_summary" />
        </receiver>
        <receiver
            android:name=".WidgetProviders$LibraryGrid"
            android:exported="false"
            android:label="@string/w_library_grid">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_library_grid" />
        </receiver>
        <receiver
            android:name=".WidgetProviders$LibraryList"
            android:exported="false"
            android:label="@string/w_library_list">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_library_list" />
        </receiver>
        <receiver
            android:name=".WidgetProviders$LibraryFeature"
            android:exported="false"
            android:label="@string/w_library_feature">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_library_feature" />
        </receiver>
        <receiver
            android:name=".WidgetProviders$LocalGrid"
            android:exported="false"
            android:label="@string/w_local_grid">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_local_grid" />
        </receiver>
        <receiver
            android:name=".WidgetProviders$LocalList"
            android:exported="false"
            android:label="@string/w_local_list">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_local_list" />
        </receiver>
        <receiver
            android:name=".WidgetProviders$LocalRow"
            android:exported="false"
            android:label="@string/w_local_row">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_local_row" />
        </receiver>

        <activity
            android:name=".WidgetConfig"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name=".ShareService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".WatchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider
            android:name=".ShareProvider"
            android:authorities="com.boardroamer.app.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
